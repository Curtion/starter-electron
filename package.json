{
  "name": "starter-electron",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "description": "An Electron + Vite + Vue 3 starter template",
  "author": "Curtion",
  "main": "dist-electron/main.mjs",
  "scripts": {
    "start": "electron .",
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:dir": "nr build && electron-builder --dir",
    "build:win": "nr build && electron-builder --win",
    "build:linux": "nr build && electron-builder --linux",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8.0.0",
    "@iconify/json": "^2.2.460",
    "@types/node": "^25.5.2",
    "@unocss/reset": "^66.6.7",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/tsconfig": "^0.9.1",
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1",
    "eslint": "^10.2.0",
    "jiti": "^2.6.1",
    "sass-embedded": "^1.99.0",
    "typescript": "~6.0.2",
    "unocss": "^66.6.7",
    "vite": "^8.0.5",
    "vue": "^3.5.32",
    "vue-router": "^5.0.4",
    "vue-tsc": "^3.2.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "electron",
      "electron-winstaller"
    ]
  },
  "build": {
    "appId": "com.curtion.starter-electron",
    "files": [
      "dist-electron/**/*",
      "dist-web/**/*"
    ],
    "win": {
      "icon": "build/logo.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "linux": {
      "icon": "build/logo.png",
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Utility"
    }
  }
}
